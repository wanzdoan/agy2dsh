{
    "name":  "agy2dsh",
    "version":  "0.8.0",
    "description":  "Use your Antigravity (Gemini) and ChatGPT Codex consumer subscriptions as DeepSeek Harness LLM providers: self-refreshing OAuth, accurate quota pill, account rotation, bilingual settings.",
    "license":  "MIT",
    "type":  "module",
    "main":  "./lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json",
                    "./cordis.patch.yml":  "./cordis.patch.yml"
                },
    "files":  [
                  "lib/",
                  "cordis.patch.yml",
                  "README.md",
                  "CHANGELOG.md",
                  "LICENSE",
                  "docs/"
              ],
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "antigravity",
                     "agy",
                     "gemini",
                     "codex",
                     "chatgpt",
                     "oauth"
                 ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/wanzdoan/agy2dsh.git"
                   },
    "homepage":  "https://github.com/wanzdoan/agy2dsh#readme",
    "bugs":  {
                 "url":  "https://github.com/wanzdoan/agy2dsh/issues"
             },
    "scripts":  {
                    "test":  "node test/imports.mjs \u0026\u0026 node test/config-volatility.mjs \u0026\u0026 node test/quota-summary.mjs",
                    "test:live":  "node test/cli-quota.mjs"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-slots"
                                          ]
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-credentials":  "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2",
                             "@deepseek-ai/dsh-host-webserver":  "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2",
                             "@deepseek-ai/dsh-llm":  "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2",
                             "@deepseek-ai/dsh-settings":  "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2",
                             "@deepseek-ai/schemastery":  "^3.18.4"
                         },
    "publishConfig":  {
                          "access":  "public"
                      },
    "dependencies":  {
                         "socks":  "^2.8.9",
                         "undici":  "^8.10.1"
                     },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.4",
                            "@deepseek-ai/dsh-credentials":  "^0.2.0-rc.2",
                            "@deepseek-ai/dsh-host-webserver":  "^0.2.0-rc.2",
                            "@deepseek-ai/dsh-llm":  "^0.2.0-rc.2",
                            "@deepseek-ai/dsh-settings":  "^0.2.0-rc.2",
                            "@deepseek-ai/schemastery":  "^3.18.4",
                            "@types/node":  "^22.20.2",
                            "eslint":  "^10.4.0",
                            "typescript":  "^7.0.2"
                        },
    "author":  "WanzDoan (https://github.com/wanzdoan)"
}